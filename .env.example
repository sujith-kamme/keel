# =============================================================================
# 1. REQUIRED: Keel will not start without these.
# =============================================================================

# Postgres and Redis (local: npm run db:up).
DATABASE_URL=postgres://keel:keel@localhost:5433/keel
REDIS_URL=redis://localhost:6379

# PayPal Sandbox app (developer.paypal.com > Apps & Credentials > Sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Claude: demo agent, reply check, Gauntlet, policy drafting.
ANTHROPIC_API_KEY=

# Keel secrets, at least 32 bytes each: openssl rand -base64 48
KEEL_SIGNING_KEY=
KEEL_MERCHANT_KEY=
# Console-only API key (review queue, kill switch, settings); must differ from KEEL_MERCHANT_KEY.
KEEL_OPERATOR_KEY=
# keel-web: seals the store chat and console cookies.
KEEL_WEB_SECRET=

# Where keel-web and the scripts reach the API.
KEEL_API_URL=http://localhost:8787

# Console login. Login has no attempt limit yet, so use a long random password: openssl rand -base64 18
CONSOLE_USER=admin@tidewell.com
CONSOLE_PASSWORD=

# =============================================================================
# 2. OPTIONAL: sensible defaults or only needed for one feature.
# =============================================================================

# PayPal webhook ID: lets Keel verify dispute webhooks. Without it, disputes arrive by polling only.
PAYPAL_WEBHOOK_ID=
# Console base URL used in review links and Zapier payloads (default http://localhost:3000; set it in production).
CONSOLE_URL=http://localhost:3000
# API port (default 8787).
API_PORT=8787
# Demo only: return the identity one-time code in the session response (there is no email delivery).
DEMO_OTP=true
# Run the job worker inside the API process (Render does this; locally, set it to run Gauntlet and dispute jobs).
RUN_WORKER=true
# AG Grid Enterprise licence. Without it the console grids show a trial watermark. Inlined at build time.
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=
# Only for scripts/seed-store.ts (imports the demo catalog).
CHANNEL3_API_KEY=
# Payer email of the Gauntlet fixture orders (default gauntlet@demo.keel.test).
# GAUNTLET_PAYER=

# =============================================================================
# 3. FIRST-BOOT DEFAULTS: managed in the console (Settings) after the API first starts.
#    The API copies these into the settings table once; later changes here are ignored.
#    All optional: leave them out to use the defaults shown.
# =============================================================================

# Guard: model that checks agent replies, and its timeout (a timeout blocks the reply).
EXTRACTOR_MODEL=claude-haiku-5-5
EXTRACTOR_TIMEOUT_MS=4000
# Risk: a session scoring at or above the threshold is quarantined; signals fade with this half-life.
RISK_THRESHOLD=60
RISK_HALF_LIFE_MIN=30
# Demo store agent: claude-haiku-5-5, claude-sonnet-5-5 or claude-opus-5-5;
# prompt lenient (eager support, the guard has to catch it) or strict (Keel-aware).
DEMO_AGENT_MODEL=claude-haiku-5-5
DEMO_AGENT_PROMPT=lenient
# Gauntlet: the model playing the customer, and parallel conversations (1-10).
GAUNTLET_CUSTOMER_MODEL=claude-haiku-5-5
GAUNTLET_CONCURRENCY=6
# Disputes: act on Defend/Concede without an operator; how often to poll PayPal (30-3600 s).
DISPUTE_AUTO_SUBMIT=true
DISPUTE_POLL_SECONDS=120
# Zapier hook for alerts (must start with https://hooks.zapier.com/).
ZAPIER_HOOK_URL=
