DATABASE_URL=postgres://keel:keel@localhost:5433/keel
REDIS_URL=redis://localhost:6379

# PayPal Sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

ANTHROPIC_API_KEY=
CHANNEL3_API_KEY=
ZAPIER_HOOK_URL=

API_PORT=8787

# Keel secrets, at least 32 bytes each: openssl rand -base64 48
KEEL_SIGNING_KEY=
KEEL_MERCHANT_KEY=
# Review queue and kill switch only; must differ from KEEL_MERCHANT_KEY.
KEEL_OPERATOR_KEY=
# Word-path extractor model: claude-haiku-5-5 (default), claude-sonnet-5-5 or claude-opus-5-5.
EXTRACTOR_MODEL=claude-haiku-5-5
# Extractor failure or timeout blocks the reply.
EXTRACTOR_TIMEOUT_MS=4000
# Demo only: return the identity OTP in the session response (no email delivery).
DEMO_OTP=true
# Used by scripts/mcp-smoke.ts and keel-web (the agent side).
KEEL_API_URL=http://localhost:8787

# keel-web: seals the store chat and console cookies, at least 32 bytes.
KEEL_WEB_SECRET=
# Demo console login (judge credentials go in the README). Login has no attempt
# limit yet, so use a long random password: openssl rand -base64 18
CONSOLE_USER=judge
CONSOLE_PASSWORD=
# Demo store agent model: claude-haiku-5-5 (default), claude-sonnet-5-5 or claude-opus-5-5.
DEMO_AGENT_MODEL=claude-haiku-5-5
# lenient = eager support prompt that /guard has to catch; strict = Keel-aware prompt.
DEMO_AGENT_PROMPT=lenient
