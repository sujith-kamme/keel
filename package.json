{
  "name": "keel",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "npm run generate -w @keel/db",
    "db:migrate": "npm run migrate -w @keel/db",
    "db:seed": "tsx --env-file=.env packages/db/seed/policies.ts",
    "dev:api": "npm run dev -w @keel/api",
    "dev:worker": "npm run dev -w @keel/worker",
    "dev:web": "npm run dev -w @keel/web",
    "dev:store": "npm run dev -w @keel/store",
    "paypal:ping": "tsx --env-file=.env scripts/paypal-ping.ts",
    "worker:ping": "tsx --env-file=.env scripts/worker-ping.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "seed:store": "tsx --env-file=.env scripts/seed-store.ts",
    "seed:context": "tsx --env-file=.env scripts/seed-context.ts",
    "smoke:mcp": "tsx scripts/mcp-smoke.ts",
    "smoke:guard": "tsx scripts/guard-smoke.ts",
    "smoke:risk": "tsx scripts/risk-smoke.ts",
    "dispute:orders": "tsx --env-file=.env scripts/dispute-orders.ts",
    "dispute:sandbox": "tsx --env-file=.env scripts/dispute-sandbox.ts",
    "smoke:dispute": "tsx scripts/dispute-smoke.ts",
    "smoke:gauntlet": "tsx scripts/gauntlet-smoke.ts",
    "postman": "tsx scripts/postman.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "openapi-to-postmanv2": "6.4.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
